{
	"rewrites": [
		{
			"source": "/admin",
			"destination": "/admin.html"
		},
		{
			"source": "/admin/(.*)",
			"destination": "/admin.html"
		},
		{
			"source": "/(.*)",
			"destination": "/"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache, no-store, must-revalidate"
				}
			]
		}
	]
}
